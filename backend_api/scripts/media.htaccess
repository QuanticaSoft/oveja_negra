# Carpeta de imágenes de OVEJA_NEGRA (la instala scripts/setup-media.sh).
# Solo se sirven imágenes: sin listado y sin ejecutar nada, aunque alguien lograra subir un script.
Options -Indexes -ExecCGI
<FilesMatch "\.(?i:php[0-9]?|phtml|phar|pl|py|cgi|sh|htaccess)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
